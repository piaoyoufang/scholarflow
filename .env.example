DASHSCOPE_API_KEY=在百炼控制台创建的Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-max
FAST_MODEL=qwen-flash
EMBEDDING_MODEL=text-embedding-v4
VECTOR_DB_DIR=./data/chroma
CHECKPOINT_DB_PATH=./data/memory/checkpoints.sqlite
AUTH_DB_PATH=./data/auth/auth.sqlite
API_BASE_URL=http://127.0.0.1:8000
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# 管理员用户名（逗号分隔，大小写不敏感），登录后可生成/吊销一次性教师邀请码、管理账号与课程
ADMIN_USERNAMES=
LOG_LEVEL=INFO
LOG_DIR=./logs
SLOW_REQUEST_MS=3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
ASK_RATE_LIMIT_MAX_REQUESTS=10
MODEL_MAX_CONCURRENCY=2
CHAT_TIMEOUT_SECONDS=60
FAST_TIMEOUT_SECONDS=30
MODEL_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_SECONDS=0.5
MCP_TIMEOUT_SECONDS=20
MCP_MAX_ATTEMPTS=2
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_TIMEOUT_SECONDS=20
DATABASE_URL=mysql+pymysql://scholarflow:scholarflow_pwd@127.0.0.1:3307/scholarflow?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=300
QDRANT_URL=local
QDRANT_PATH=./data/qdrant_local
QDRANT_COLLECTION=scholarflow_chunks
QDRANT_VECTOR_SIZE=1024
VECTOR_BACKEND=qdrant
RELATIONAL_BACKEND=mysql
