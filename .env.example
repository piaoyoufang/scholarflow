ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=INFO
LOG_DIR=./logs
SLOW_REQUEST_MS=3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
ASK_RATE_LIMIT_MAX_REQUESTS=10
