FAST_TIMEOUT_SECONDS=30
MODEL_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_SECONDS=0.5
MCP_TIMEOUT_SECONDS=20
MCP_MAX_ATTEMPTS=2
